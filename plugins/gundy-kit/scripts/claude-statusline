#!/usr/bin/env bash
# Claude Code status line. Shows the work item the session is on (set by
# /work-issue via claude-work-item), or a default "<repo> · <branch>" when idle,
# followed by a colour-coded context-window percentage (dotfiles#113 — an audit
# found no session had any visibility into context usage at all).
# Reads the session JSON on stdin; prints one line to stdout.
set -uo pipefail

STATE_DIR="$HOME/.claude/work-item"

# SHA-1 of stdin, first field only. macOS ships /usr/bin/shasum (perl); on
# Linux that path is absent (Arch keeps it under /usr/bin/core_perl, often off
# PATH in hooks), so fall back to coreutils sha1sum — same digest either way.
sha1_key() {
  if [ -x /usr/bin/shasum ]; then /usr/bin/shasum; else sha1sum; fi | cut -d' ' -f1
}
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Same state dir claude-tool-guard already keys its per-session counters
# under (dotfiles#113 follow-up): the statusline JSON is the ONLY place
# context_window.context_window_size is ever handed to us — a PreToolUse
# hook's input carries no context_window field at all — so this is the one
# chance to record the model's real window size for claude-context-gauge's
# model-name table to be overridden by later PreToolUse calls in the same
# session (e.g. an orchestrator model like claude-fable-5-1 that runs a
# 1,000,000-token window without an `[1m]`/`-1m` id suffix).
CTX_STATE_DIR="${TMPDIR:-/tmp}/claude-tool-guard"
input=$(cat)

cwd=$(printf '%s' "$input" | jq -r '.workspace.current_dir // .cwd // empty')
[ -z "$cwd" ] && cwd="$PWD"

root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$cwd")
file="$STATE_DIR/$(printf '%s' "$root" | sha1_key).json"

dim=$'\e[2m'; reset=$'\e[0m'; yellow=$'\e[33m'; magenta=$'\e[35m'; cyan=$'\e[36m'
green=$'\e[32m'; red=$'\e[31m'

# Context percentage: prefer the pre-calculated field the statusline JSON
# already carries (code.claude.com/docs/en/statusline.md,
# `context_window.used_percentage`); fall back to the gauge on the session's
# own transcript when the field is absent (older Claude Code, or a field
# rename) so the segment degrades instead of disappearing.
session_id=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)
window_size=$(printf '%s' "$input" | jq -r '.context_window.context_window_size // empty' 2>/dev/null)
if [ -n "$session_id" ] && [ -n "$window_size" ] && [ "$window_size" != "null" ] \
   && [ "$window_size" -gt 0 ] 2>/dev/null && mkdir -p "$CTX_STATE_DIR" 2>/dev/null; then
  printf '%s\n' "$window_size" > "$CTX_STATE_DIR/$session_id.window" 2>/dev/null || true
fi

ctx_pct=$(printf '%s' "$input" | jq -r '.context_window.used_percentage // empty' 2>/dev/null)
if [ -z "$ctx_pct" ] || [ "$ctx_pct" = "null" ]; then
  transcript=$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null)
  if [ -n "$transcript" ] && [ -x "$BIN_DIR/claude-context-gauge" ]; then
    gauge_out=$("$BIN_DIR/claude-context-gauge" "$transcript" 2>/dev/null) && ctx_pct=$(awk '{print $1}' <<<"$gauge_out")
  fi
fi

ctx_segment=""
if [ -n "${ctx_pct:-}" ] && [ "$ctx_pct" != "null" ]; then
  ctx_int=${ctx_pct%.*}
  [ -n "$ctx_int" ] || ctx_int=0
  if [ "$ctx_int" -ge 80 ] 2>/dev/null; then
    ctx_color="$red"
  elif [ "$ctx_int" -ge 50 ] 2>/dev/null; then
    ctx_color="$yellow"
  else
    ctx_color="$green"
  fi
  ctx_segment=$(printf ' · %s%s%%%s' "$ctx_color" "$ctx_int" "$reset")
fi

if [ -f "$file" ]; then
  issue=$(jq -r '.issue' "$file")
  phase=$(jq -r '.phase' "$file")
  title=$(jq -r '.title' "$file")
  [ "${#title}" -gt 40 ] && title="${title:0:39}…"
  repo=$(basename "$root")
  case "$phase" in
    looking)   printf '%s%s%s · %s🔍 #%s looking%s · %s%s' "$dim" "$repo" "$reset" "$cyan"    "$issue" "$reset" "$title" "$ctx_segment" ;;
    working)   printf '%s%s%s · %s🔨 #%s working%s · %s%s' "$dim" "$repo" "$reset" "$yellow"  "$issue" "$reset" "$title" "$ctx_segment" ;;
    in-review) printf '%s%s%s · %s👀 #%s in review%s · %s%s' "$dim" "$repo" "$reset" "$magenta" "$issue" "$reset" "$title" "$ctx_segment" ;;
    *)         printf '%s%s%s · #%s %s · %s%s' "$dim" "$repo" "$reset" "$issue" "$phase" "$title" "$ctx_segment" ;;
  esac
else
  repo=$(basename "$root")
  branch=$(git -C "$cwd" branch --show-current 2>/dev/null || true)
  if [ -n "$branch" ]; then
    printf '%s%s · %s%s%s' "$dim" "$repo" "$branch" "$reset" "$ctx_segment"
  else
    printf '%s%s%s%s' "$dim" "$repo" "$reset" "$ctx_segment"
  fi
fi
