#!/usr/bin/env bash
# kit-merge — the ONLY way anything in this plugin ships (merges) a pull
# request. Refuses unless every gate holds, then squash-merges, deletes the
# branch, and moves the issue(s) it closes to Done on the board.
#
# Usage: kit-merge <pr-number> [--repo OWNER/name]
#   --repo defaults to .kit/config.json's "repo", found by searching upward
#   from $PWD (same lookup as kit-board) — so this normally runs from inside
#   the repo or one of its kit-worktree checkouts.
#
# Gates (all must hold, in this order):
#   1. the target repo is listed in .kit/config.json's merge_allowlist —
#      nothing ships anywhere else, no exceptions;
#   2. the PR is open, not a draft, and GitHub reports it mergeable
#      (mergeable_state "clean" — "behind"/"dirty"/"blocked"/"unstable" all
#      refuse; a "null"/"unknown" read is re-checked once after GitHub has
#      had a moment to compute it);
#   3. the head branch name starts with "kit/" — only branches this plugin's
#      own /dispatch opened are ever merged through here;
#   4. a PR comment reading exactly
#      <!-- kit-review: APPROVE sha=<current head sha> --> exists. A stale
#      approval (the sha in the comment doesn't match the PR's current head)
#      does not count — any push after review needs a fresh review;
#   5. the PR does NOT carry the kit-needs-help label.
#
# On success: squash-merges with --delete-branch, verifies GitHub reports it
# merged, then moves every issue the PR's body closes (Closes/Fixes/Resolves
# #N) to Done on the board. The board move is best-effort — a board hiccup
# after a real merge is reported, never treated as the merge failing.
#
# Exit codes: 0 shipped (or already shipped) · 1 a gate failed (message says
# which) · 4 GitHub API failure · 64 usage / missing config.
set -euo pipefail

die() { echo "kit-merge: $1" >&2; exit "${2:-1}"; }
usage() { sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

REPO=""
PR=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) [ $# -ge 2 ] || die "--repo needs a value" 64; REPO=$2; shift 2 ;;
    -h|--help) usage 0 ;;
    *)
      [ -z "$PR" ] || die "unexpected argument '$1'" 64
      PR=$1; shift ;;
  esac
done
[ -n "$PR" ] || die "usage: kit-merge <pr-number> [--repo OWNER/name]" 64
case "$PR" in ''|*[!0-9]*) die "PR number must be a whole number, got '$PR'" 64 ;; esac

find_config() {
  local dir="$PWD"
  while true; do
    if [ -f "$dir/.kit/config.json" ]; then
      printf '%s\n' "$dir/.kit/config.json"
      return 0
    fi
    [ "$dir" = "/" ] && return 1
    dir=$(dirname "$dir")
  done
}

CONFIG_PATH=$(find_config) || die "no .kit/config.json found searching upward from $PWD. This repo hasn't been set up for the board yet — run kit-setup." 64
jq -e . "$CONFIG_PATH" >/dev/null 2>&1 || die "$CONFIG_PATH exists but isn't valid JSON — fix or recreate it." 64

if [ -z "$REPO" ]; then
  REPO=$(jq -r '.repo // empty' "$CONFIG_PATH")
  [ -n "$REPO" ] || die "$CONFIG_PATH is missing \"repo\" — add it, e.g. \"repo\": \"OWNER/name\"." 64
fi

# --- gate 1: repo is on the merge allowlist -------------------------------------------
in_allowlist=$(jq -r --arg r "$REPO" '(.merge_allowlist // []) | any(. == $r)' "$CONFIG_PATH")
[ "$in_allowlist" = "true" ] || die "$REPO is not in .kit/config.json's merge_allowlist — nothing ships from this repo until an operator adds it there." 1

pr_json=$(gh api --method GET "repos/$REPO/pulls/$PR" 2>/dev/null) || die "couldn't read $REPO#$PR (GitHub API error)." 4
state=$(jq -r '.state' <<<"$pr_json")
draft=$(jq -r '.draft' <<<"$pr_json")
merged=$(jq -r '.merged' <<<"$pr_json")
head_sha=$(jq -r '.head.sha' <<<"$pr_json")
head_ref=$(jq -r '.head.ref' <<<"$pr_json")
base_ref=$(jq -r '.base.ref' <<<"$pr_json")
url=$(jq -r '.html_url' <<<"$pr_json")
mergeable=$(jq -r '.mergeable' <<<"$pr_json")
mstate=$(jq -r '.mergeable_state // "unknown"' <<<"$pr_json")
body=$(jq -r '.body // ""' <<<"$pr_json")
needs_help=$(jq -r '[.labels[]?.name] | any(. == "kit-needs-help")' <<<"$pr_json")

[ "$merged" = "true" ] && { echo "Already shipped: $url"; exit 0; }

# --- gate 2: open, not a draft, mergeable ------------------------------------------------
[ "$state" = "open" ] || die "$url is $state, not open — nothing to ship." 1
[ "$draft" = "true" ] && die "$url is still marked as a draft — mark it ready for review first." 1

if [ "$mergeable" = "null" ] || [ "$mstate" = "unknown" ]; then
  sleep 3
  pr_json=$(gh api --method GET "repos/$REPO/pulls/$PR" 2>/dev/null) || die "couldn't re-read $url." 4
  new_head=$(jq -r '.head.sha' <<<"$pr_json")
  [ "$new_head" = "$head_sha" ] || die "$url got a new push while kit-merge was checking it — run kit-merge again so the review is checked against the new commit." 1
  mergeable=$(jq -r '.mergeable' <<<"$pr_json")
  mstate=$(jq -r '.mergeable_state // "unknown"' <<<"$pr_json")
fi
case "$mstate" in
  clean) ;;
  behind) die "$url is behind $base_ref — bring it up to date and let it get reviewed again before shipping." 1 ;;
  dirty) die "$url has merge conflicts with $base_ref — it needs to be rebased first." 1 ;;
  blocked|unstable) die "$url isn't ready to ship yet (GitHub reports '$mstate') — a required check or review is missing." 1 ;;
  *) die "$url isn't mergeable right now (mergeable_state=$mstate)." 1 ;;
esac

# --- gate 3: only this plugin's own branches ----------------------------------------
case "$head_ref" in
  kit/*) ;;
  *) die "$url's branch ('$head_ref') wasn't opened by this plugin (branches this plugin ships start with kit/) — refusing to merge it through kit-merge." 1 ;;
esac

# --- gate 4: a fresh APPROVE review for this exact head -------------------------------
comments=$(gh api --method GET --paginate "repos/$REPO/issues/$PR/comments" --jq '.[].body' 2>/dev/null) || die "couldn't read $url's comments." 4
approved=0
while IFS= read -r line; do
  sha=$(sed -nE 's/.*<!-- kit-review: APPROVE sha=([0-9a-f]+) -->.*/\1/p' <<<"$line")
  [ -n "$sha" ] && [ "$sha" = "$head_sha" ] && approved=1
done <<<"$comments"
[ "$approved" -eq 1 ] || die "$url has no APPROVE review for its current commit (${head_sha:0:7}) — either it hasn't been reviewed yet, or it was pushed to after the last review. Get it reviewed again." 1

# --- gate 5: not flagged as needing a human -------------------------------------------
[ "$needs_help" = "true" ] && die "$url is labeled kit-needs-help — a human needs to look at it before it ships." 1

# --- merge ------------------------------------------------------------------------------
merge_out=$(gh pr merge "$PR" -R "$REPO" --squash --delete-branch --match-head-commit "$head_sha" 2>&1) || die "the merge call itself failed: $merge_out" 4
verify=$(gh api --method GET "repos/$REPO/pulls/$PR" --jq '.merged' 2>/dev/null) || verify="false"
[ "$verify" = "true" ] || die "GitHub still reports $url as not merged after the merge call — check it by hand." 4
echo "Shipped: $url (squash-merged, branch deleted)."

# --- best-effort: move the closed issue(s) to Done on the board ----------------------
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
issues=$(grep -oiE '(close[sd]?|fix(e[sd])?|resolve[sd]?)[[:space:]]*:?[[:space:]]*#[0-9]+' <<<"$body" | grep -oE '[0-9]+$' | sort -u || true)
while IFS= read -r n; do
  [ -n "$n" ] || continue
  "$BIN_DIR/kit-board" move "$n" Done || echo "note: shipped, but couldn't move #$n to Done on the board — move it by hand." >&2
done <<<"$issues"

exit 0
